<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Butonun arka plan rengi (Beyaz veya duruma göre #00000000 ile şeffaf yapabilirsiniz) -->
    <solid android:color="#FFFFFF" />

    <!-- Lacivert Çerçeve (Stroke) -->
    <stroke
        android:width="1.5dp"
        android:color="#1B263B" />

    <!-- Köşe yuvarlaklığı (4dp) -->
    <corners android:radius="4dp" />
</shape>